{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "group:all"],
  "minimumReleaseAge": "7 days",
  "internalChecksFilter": "strict",
  "lockFileMaintenance": {
    "enabled": true,
    "groupName": "all dependencies"
  },
  "customManagers": [
    {
      "description": "Rust toolchain pinned in toolchains.toolchain(version = ...) in MODULE.bazel",
      "customType": "regex",
      "managerFilePatterns": ["/^MODULE\\.bazel$/"],
      "matchStrings": ["toolchains\\.toolchain\\([^)]*\\bversion = \"(?<currentValue>\\d+\\.\\d+\\.\\d+)\""],
      "depNameTemplate": "rust",
      "datasourceTemplate": "rust-version"
    }
  ]
}
