load("@crates//weather:data.bzl", "all_crate_deps", "crate_data")
load("@rules_rs//rs:rust_library.bzl", "rust_library")

rust_library(
    name = "weather",
    srcs = glob(["src/**/*.rs"]),
    # uniffi::setup_scaffolding!() reads the package name from Cargo.toml.
    compile_data = ["Cargo.toml"],
    # Features as Cargo unifies them across the workspace, including `uniffi` from the app FFI crates.
    crate_features = crate_data()["crate_features"],
    lint_config = crate_data().get("lint_config"),
    visibility = ["//visibility:public"],
    deps = all_crate_deps(normal = True),
)
