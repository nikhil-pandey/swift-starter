load("@crates//weather-ffi:data.bzl", "all_crate_deps", "crate_data")
load("@rules_rs//rs:rust_static_library.bzl", "rust_static_library")
load("//tools/uniffi:uniffi.bzl", "uniffi_swift_library")

# The single Rust static library linked into apps/weather.
rust_static_library(
    name = "weather-ffi",
    srcs = glob(["src/**/*.rs"]),
    # uniffi::setup_scaffolding!() reads the package name from Cargo.toml.
    compile_data = ["Cargo.toml"],
    crate_name = "weather_ffi",
    lint_config = crate_data().get("lint_config"),
    visibility = ["//visibility:public"],
    deps = all_crate_deps(normal = True),
)

# Swift module `WeatherCore`: the Swift API apps/weather imports.
uniffi_swift_library(
    name = "WeatherCore",
    crates = [
        "weather",
        "weather_ffi",
    ],
    library = ":weather-ffi",
    visibility = ["//visibility:public"],
)
