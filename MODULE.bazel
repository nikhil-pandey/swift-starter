module(name = "apps")

# apple_support first so its Xcode C/C++ toolchain wins for Apple targets: rules_apple and rules_swift need it.
bazel_dep(name = "apple_support", version = "2.12.0")
bazel_dep(name = "aws-lc", version = "5.1.0.bcr.3")
bazel_dep(name = "llvm", version = "0.8.27")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_apple", version = "5.4.0")
bazel_dep(name = "rules_cc", version = "0.2.28")
bazel_dep(name = "rules_rs", version = "0.2.4")
bazel_dep(name = "rules_shell", version = "0.8.0")
bazel_dep(name = "rules_swift", version = "4.2.2")
bazel_dep(name = "rules_xcodeproj", version = "4.1.0")

# Hermetic Rust toolchains for the host and the iOS device and simulator targets. On Linux hosts .bazelrc adds the
# hermetic LLVM C/C++ toolchain, so the Rust crates build and lint there without Xcode.
toolchains = use_extension("@rules_rs//rs/toolchains:module_extension.bzl", "toolchains")
toolchains.toolchain(
    edition = "2024",
    version = "1.100.0",
)
use_repo(toolchains, "default_rust_toolchains")

register_toolchains("@default_rust_toolchains//...")

# Lint and format aspects come from the rules_rust that rules_rs provides.
rules_rust = use_extension("@rules_rs//rs:rules_rust.bzl", "rules_rust")
use_repo(rules_rust, "rules_rust")

# Rust dependencies come from the Cargo workspace, so cargo, rust-analyzer, and Renovate keep working.
crate = use_extension("@rules_rs//rs:extensions.bzl", "crate")

# aws-lc-sys links aws-lc from the Bazel Central Registry, built with the same C toolchain, instead of running its
# build script.
crate.annotation(
    crate = "aws-lc-rs",
    gen_build_script = "off",
)
crate.annotation(
    additive_build_file = "@rules_rs//3rd_party/aws-lc-sys:additive.BUILD.bazel",
    crate = "aws-lc-sys",
    extra_aliased_targets = {"aws_lc_sys_build_info": "aws_lc_sys_build_info"},
    gen_build_script = "off",
    rustc_flags = ["--cfg=use_bindgen_pregenerated"],
    deps = ["@crates//aws_lc_sys_build_info"],
)
crate.from_cargo(
    name = "crates",
    cargo_lock = "//:Cargo.lock",
    cargo_toml = "//:Cargo.toml",
    generate_lint_config = True,
    incompatible_no_root_alias_targets = True,
    incompatible_no_root_crate_data = True,
    # macOS and Linux hosts, plus the iOS device and simulator targets.
    platform_triples = [
        "aarch64-apple-darwin",
        "aarch64-apple-ios",
        "aarch64-apple-ios-sim",
        "aarch64-unknown-linux-gnu",
        "x86_64-unknown-linux-gnu",
    ],
)
inject_repo(crate, "aws-lc")
use_repo(crate, "crates")
